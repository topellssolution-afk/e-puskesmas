generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Patient {
  id               String   @id @default(cuid())
  nik              String   @unique
  name             String
  birthdate        String
  gender           String
  address          String
  phone            String
  poli             String
  registrationDate DateTime @default(now())
}
